HF_TOKEN_FILE=.hf_token
HOST=0.0.0.0
PORT=8765

# ASR backend: faster_whisper (default) | whisper_cpp
TRANSCRIPTION_ENGINE=faster_whisper

# whisper.cpp server (only used when TRANSCRIPTION_ENGINE=whisper_cpp)
WHISPER_CPP_URL=http://127.0.0.1:8081
WHISPER_CPP_TIMEOUT=3600
WHISPER_CPP_CONNECT_TIMEOUT=5
WHISPER_CPP_RETRIES=3
