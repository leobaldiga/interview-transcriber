HF_TOKEN_FILE=.hf_token
HOST=0.0.0.0
PORT=8765

# =========================
# COMPUTE DEVICE SELECTION
# =========================
# Optional: override which Python interpreter runs each worker subprocess.
# Omit both to use the legacy .venv / .venv-pyannote defaults. Relative paths
# resolve against the repo root. The Pascal profile environments are built
# with:  python3 scripts/setup_worker_envs.py
# (This file is NOT auto-loaded by app.py — export these into the shell that
#  launches `python app.py`, e.g. `export $(grep -v '^#' .env | xargs)`.)

#WHISPER_WORKER_PYTHON=.venv-whisper-pascal/bin/python
#PYANNOTE_WORKER_PYTHON=.venv-pyannote-pascal/bin/python

# Optional: alternate location for the persistent compute settings
# (config/compute.json by default; also holds compute-report.json).
#COMPUTE_SETTINGS_PATH=config/compute.json
